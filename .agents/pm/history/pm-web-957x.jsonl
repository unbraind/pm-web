{"hash_algorithm":"sha256","ts":"2026-10-05T04:42:46.632Z","author":"pi-glm","author_source":"asserted","agent_harness":"pi","agent_model":"glm-5.3:cloud","agent_model_source":"environment","agent_instance":"535465f5459a0ca510494480","agent_provenance":{"model":{"value":"glm-5.3:cloud","source":"environment"},"effort":null,"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-web-957x"},{"op":"add","path":"/metadata/title","value":"pm-web test-add route passes a token shape the CLI rejects, so linking a test from the UI always fails"},{"op":"add","path":"/metadata/description","value":"POST /api/projects/:projectId/pm/tests/:itemId builds ['test', id, '--add', '--command', command], but pm item test --add takes ONE CSV/JSON argument; the two-token --command form is rejected with exit 2, and --description is not a valid option on that path. The route now passes --add-json with the command and the optional description as the note key, which keeps commands containing commas or equals signs intact."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":2},{"op":"add","path":"/metadata/tags","value":["bug","http-semantics","linked-tests"]},{"op":"add","path":"/metadata/created_at","value":"2026-10-05T04:42:46.632Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-10-05T04:42:46.632Z"},{"op":"add","path":"/metadata/author","value":"pi-glm"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"db56f143cc4ca5e5743e2d55526e51629fd12736f8f0e612dcc7e08eb00007e1","item_hash_version":3,"message":"","event_class":"substantive","record_hash_version":1,"record_hash":"1b7d691d238aa85de03dda61fb227a1c2b99ec5d8bc08ac52b80ac9a6443aa97"}
