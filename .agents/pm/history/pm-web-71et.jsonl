{"hash_algorithm":"sha256","ts":"2026-10-26T15:11:02.870Z","author":"pi-glm","author_source":"asserted","agent_harness":"pi","agent_model":"glm-5.3:cloud","agent_model_source":"environment","agent_instance":"2b565717ecfe2e5f2312d1ec","agent_provenance":{"model":{"value":"glm-5.3:cloud","source":"environment"},"effort":null,"role":null,"topic":null},"op":"comment_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-10-26T15:11:02.870Z"},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-10-26T15:11:02.870Z","author":"pi-glm","text":"Cause: the Dependabot workflow ref bump (2026.10.16 -> 2026.10.19) updated the sha pin and the release comment on both canonical pm-github callers but did not update the 'pm-github-version' reusable workflow input, so the pin policy test fails on 'the workflow release and package version must match' (expected 2026.10.19, actual 2026.10.16). The pinned commit is the pm-github v2026.10.19 release commit, so the bump is a valid reviewed release. Fix: move the 'pm-github-version' input to 2026.10.19 on each bumped caller so pin, comment and package input match. The pin policy itself is unchanged and still enforced."}]}],"before_hash":"d16872155b9a3f21a0c4cebe984d9b3b6c78b155d709082a87d4599fb048bd77","after_hash":"ed2cc58b6a2db8a884966c03e4723a0c55290eef50e4f86fd8a55ea9b6abc401","item_hash_version":3,"event_class":"substantive","record_hash_version":1,"record_hash":"df6598447cd388e044662c7e457a048a79b5a7d528f37262ad333db2f4ddc926"}
