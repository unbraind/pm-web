{"hash_algorithm":"sha256","ts":"2026-11-04T18:09:51.465Z","author":"claude-hub","author_source":"asserted","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"259b6fa8d51ec5e6f7d340fb","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":null,"topic":null,"version":{"value":"2.1.317","source":"probe"}},"op":"comment_add","patch":[{"op":"add","path":"/metadata/comments/1","value":{"created_at":"2026-11-04T18:09:51.465Z","author":"claude-hub","text":"2026-11-04: both callers re-pinned from pm-github 2026.11.02 (a935d7b) to 2026.11.04 (eb89c6a, tag v2026.11.04). 2026.11.04 carries #214, which normalizes zero-padded release tags (v2026.11.04 to npm 2026.11.4) before the reusable workflows verify and install the version, and #213, the import privacy gate fix for public technical forms such as #218's regex literal. Between the two releases the reusable workflows changed only that normalization: no new inputs, secrets or permissions. Merged main (bc3c5d0, Release pm-web v2026.11.04). workflow-security and workflow-update-automation pass 8/8, and typecheck passes."}},{"op":"replace","path":"/metadata/updated_at","value":"2026-11-04T18:09:51.465Z"}],"before_hash":"68f0420789edf8e4960a1d5e07c5617e7e0e1554248a462b3840d026a2916f0c","after_hash":"b02a47b5c43eb78478e794cd6eeaf9e292403dced9261c28359ac052409a5ae2","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"cf8ea3c41ae7b2aafe81c124e675af0f160ac12ddb080cf95c7c2fc3bd14d709"}
