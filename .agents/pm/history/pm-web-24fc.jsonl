{"hash_algorithm":"sha256","ts":"2026-09-26T16:28:18.370Z","author":"codex","author_source":"asserted","agent_harness":"codex","agent_model":"gpt-6-sol","agent_model_source":"probe","agent_instance":"d1738b58d58bd67fa4411935","agent_provenance":{"model":{"value":"gpt-6-sol","source":"probe"},"effort":{"value":"high","source":"probe"},"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-web-24fc"},{"op":"add","path":"/metadata/title","value":"Graph neighbors GET activates extension code for view-only collaborators"},{"op":"add","path":"/metadata/description","value":"GET /api/projects/:projectId/pm/graph/neighbors/:nodeId is exempt from edit permission but calls projectPm with pm-graph neighbors. The pm CLI loads and activates installed extensions for that command, so a viewer can trigger extension activation through a safe-method route. This route does not call ensureGraphExtension, so it is distinct from the graph overview provisioning bug pm-web-jpa6. Confirm with a real marker-extension route test and move the read to an observational, tenant-scoped path without removing neighbor information."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":0},{"op":"add","path":"/metadata/tags","value":[]},{"op":"add","path":"/metadata/created_at","value":"2026-09-26T16:28:18.370Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-09-26T16:28:18.370Z"},{"op":"add","path":"/metadata/author","value":"codex"},{"op":"add","path":"/metadata/acceptance_criteria","value":"A view-only GET/HEAD neighbors request never installs, activates, or mutates extensions; it returns accurate one-hop neighbors for authorized project data; the existing response contract is preserved or explicitly versioned; real HTTP/PostgreSQL/PM workspace tests prove activation marker absence, viewer access, edit guard on any provisioning, and tenant isolation."}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"dcf052896f1c09b90407d869c0741b900f9890c31dbbf799a44b076892a95b67","item_hash_version":3,"message":"","context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"effort":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"version":{"status":"unavailable","reason":"harness_unavailable","resolver":"ai_agent_version","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"371e26e9fb12f324f09826cf85c04ad07d5c5309812708845a4776cf7871cd92"}
