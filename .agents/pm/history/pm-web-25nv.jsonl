{"ts":"2026-08-28T14:55:13.653Z","author":"claude","author_source":"asserted","agent_harness":"claude-code","agent_instance":"7405dc9b453c8154184ac8fe","agent_provenance":{"model":null,"effort":{"value":"xhigh","source":"environment"},"role":null,"topic":null},"op":"comment_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-08-28T14:55:13.653Z"},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-08-28T14:55:13.653Z","author":"claude","text":"Revert-checked: restoring the one-hop default drops the new test from passing to failing, so it measures the fix rather than describing it. The complementary test that opts into one hop and asserts the limiter follows the real client behind a proxy still passes, so the proxied behaviour is unchanged. Fifteen tests in the suite pass. Raised by Greptile as a P1 security finding on PR 110."}]}],"before_hash":"5595c324c072d58b67082cd0b8adde3592b6ffeaf400b6df22f44d16ae9c465f","after_hash":"4710256aaf96aa7ab61fbbcad2261ae0915a95581b40b234931b67a5887fa9d5","item_hash_version":2,"context":{"agent_provenance_outcomes":{"model":{"status":"failed","reason":"resolver_failed","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"failed","reason":"resolver_failed","resolver":"claude_session_file","rule_version":"v1"}}}}
