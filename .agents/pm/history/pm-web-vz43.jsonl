{"ts":"2026-08-31T18:22:37.279Z","author":"claude","author_source":"asserted","agent_harness":"claude-code","agent_instance":"2e37782ad60a9b8410683521","agent_provenance":{"model":null,"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-web-vz43"},{"op":"add","path":"/metadata/title","value":"Converge the pinned pm CLI on 2026.8.31 and drop the supplemental checks the SDK now owns"},{"op":"add","path":"/metadata/description","value":"pm CLI changed its history-hash computation between 2026.8.22 and 2026.8.24, so bumping the pinned binary made pm health --strict-exit fail with history_drift_chain_mismatch even though the before_hash/after_hash chain is perfectly linked. Repairing the hashes under the pinned 2026.8.31 binary clears it. Bumping the SDK also revealed that pm CLI 2026.8.31 closed unbraind/pm-cli#1078: certifyCompleteListResult now rejects the source-counter, omission-receipt, output-receipt and truncation-disclosure shapes that pm-web was checking itself, leaving those pm-web branches unreachable. One gap remains, so one supplemental check stays."},{"op":"add","path":"/metadata/type","value":"Chore"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":2},{"op":"add","path":"/metadata/tags","value":[]},{"op":"add","path":"/metadata/created_at","value":"2026-08-31T18:22:37.279Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-08-31T18:22:37.279Z"},{"op":"add","path":"/metadata/author","value":"claude"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"4c83cc7260e0100a169f1ec46e9546b3adc108bae16cb98f97543679ad35b7a1","item_hash_version":3,"message":"","context":{"agent_provenance_outcomes":{"model":{"status":"failed","reason":"resolver_failed","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"failed","reason":"resolver_failed","resolver":"claude_session_file","rule_version":"v1"}}}}
