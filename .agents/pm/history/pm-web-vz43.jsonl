{"ts":"2026-08-31T18:25:15.680Z","author":"claude","author_source":"asserted","agent_harness":"claude-code","agent_instance":"2e37782ad60a9b8410683521","agent_provenance":{"model":null,"effort":{"value":"xhigh","source":"environment"},"role":null,"topic":null},"op":"learning_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-08-31T18:25:15.680Z"},{"op":"add","path":"/metadata/learnings","value":[{"created_at":"2026-08-31T18:25:15.680Z","author":"claude","text":"pm CLI 2026.8.31 closed unbraind/pm-cli#1078: certifyCompleteListResult now rejects unreadable source counters, a missing or contradictory omission receipt, a missing or invalid read_output receipt, and an output_budget_truncation disclosure. Measured each shape against the SDK directly. It still accepts output_budget_exceeded, so exactly one supplemental check remains justified in pm-web."}]}],"before_hash":"c7dac2f51a114dd2f440d08a0723474a5b1b71703047240eeaaaf7c5d0ecbdb0","after_hash":"c7850eb0071d9cce75c06620ca6ca8f8d72768825fc5c6f5607dd9baed1bb30e","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"failed","reason":"resolver_failed","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"failed","reason":"resolver_failed","resolver":"claude_session_file","rule_version":"v1"}}}}
{"ts":"2026-08-31T18:25:16.166Z","author":"claude","author_source":"asserted","agent_harness":"claude-code","agent_instance":"2e37782ad60a9b8410683521","agent_provenance":{"model":null,"effort":{"value":"xhigh","source":"environment"},"role":null,"topic":null},"op":"comment_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-08-31T18:25:16.166Z"},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-08-31T18:25:16.166Z","author":"claude","text":"Bumping the pin surfaced two defects the packaging tests caught: npm i -D moved @unbrained/pm-cli from dependencies to devDependencies, which would have dropped it from the Docker image built with --omit=dev; and manifest.json pm_min_version must track the exact runtime SDK, so it moved 2026.8.21 to 2026.8.31."}]}],"before_hash":"c7850eb0071d9cce75c06620ca6ca8f8d72768825fc5c6f5607dd9baed1bb30e","after_hash":"2dd95300b5fe584cfedfd8b34068da7d2d3b9a1af49414f85aa4114969802318","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"failed","reason":"resolver_failed","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"failed","reason":"resolver_failed","resolver":"claude_session_file","rule_version":"v1"}}}}
