{"ts":"2026-08-10T05:51:10.714Z","author":"pi-agent","author_source":"asserted","agent_harness":"pi","agent_model":"glm-5.2:cloud","agent_model_source":"environment","agent_instance":"b023d9a6d1da61a93b66c9eb","agent_provenance":{"model":{"value":"glm-5.2:cloud","source":"environment"},"effort":null,"role":null,"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-web-zz37"},{"op":"add","path":"/metadata/title","value":"SW mutation queue: IndexedDB read failure indistinguishable from empty queue"},{"op":"add","path":"/metadata/description","value":"getQueuedMutations returned [] on storage failure, making flushMutationQueue treat an unreadable queue as drained — real data-loss bug. Fixed with a discriminated QueueReadResult type so callers can branch on read failure vs empty queue."},{"op":"add","path":"/metadata/type","value":"Bug"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":2},{"op":"add","path":"/metadata/tags","value":[]},{"op":"add","path":"/metadata/created_at","value":"2026-08-10T05:51:10.714Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-08-10T05:51:10.714Z"},{"op":"add","path":"/metadata/author","value":"pi-agent"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"5903e7e7f32301abd3f4d8ba81e07b7af4c5705fce6d2bab2a478c42516f19c3","message":""}
{"ts":"2026-08-10T05:51:39.662Z","author":"pi-agent","author_source":"asserted","agent_harness":"pi","agent_model":"glm-5.2:cloud","agent_model_source":"environment","agent_instance":"b023d9a6d1da61a93b66c9eb","agent_provenance":{"model":{"value":"glm-5.2:cloud","source":"environment"},"effort":null,"role":null,"topic":null},"op":"note_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-08-10T05:51:39.662Z"},{"op":"add","path":"/metadata/notes","value":[{"created_at":"2026-08-10T05:51:39.662Z","author":"pi-agent","text":"Root cause: getQueuedMutations caught all errors and returned [], collapsing storage failure and empty queue. flushMutationQueue then treated [] as drained. Fix: introduced QueueReadResult discriminated type. flushMutationQueue now detects !ok on initial read (aborts) and final read (reports MUTATIONS_PARTIAL, never MUTATIONS_REPLAYED)."}]}],"before_hash":"5903e7e7f32301abd3f4d8ba81e07b7af4c5705fce6d2bab2a478c42516f19c3","after_hash":"b0b257b6eb9f14ee4aca84bef72d33f8734e2b214c7dc48aeb6412d4022c3648"}
