{"hash_algorithm":"sha256","ts":"2026-11-03T10:24:56.230Z","author":"toolchain-web-1103","author_source":"asserted","agent_harness":"pi","agent_model":"glm-5.3:cloud","agent_model_source":"environment","agent_instance":"dea03de07548ea698db91bc1","agent_provenance":{"model":{"value":"glm-5.3:cloud","source":"environment"},"effort":null,"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-web-se1p"},{"op":"add","path":"/metadata/title","value":"Adopt pm CLI 2026.10.30 explicit history order in the pm-toolchain bump (PR 289)"},{"op":"add","path":"/metadata/description","value":"The pm-toolchain Dependabot bump to @unbrained/pm-cli 2026.10.30 changed the CLI history contract (GH-1617): display order is now explicit and consistent across projections, compact output arrives newest-first with an order label, and a --order option was added. Track the pm-web migration: the normalizer fixture in the projection test, the explicit order request in the history page reader, and the unrelated src/server.js log line seen in CI."},{"op":"add","path":"/metadata/type","value":"Chore"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":2},{"op":"add","path":"/metadata/tags","value":["dependencies","gh:unbraind/pm-web#289","migration","sdk"]},{"op":"add","path":"/metadata/created_at","value":"2026-11-03T10:24:56.230Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-11-03T10:24:56.230Z"},{"op":"add","path":"/metadata/author","value":"toolchain-web-1103"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"f6c3cdbcae6676dbbad4abdb5d655b988b78779a0f3757d25fc5dad44e079a9a","item_hash_version":3,"message":"","event_class":"substantive","record_hash_version":1,"record_hash":"8f8f249434a8208e4d645e9951cd42f6e2be638bcea720dcf0f4484b1a6e5e7f"}
