{"hash_algorithm":"sha256","ts":"2026-09-26T15:49:25.707Z","author":"codex","author_source":"configured","agent_harness":"codex","agent_model":"gpt-6-sol","agent_model_source":"probe","agent_instance":"d1738b58d58bd67fa4411935","agent_provenance":{"model":{"value":"gpt-6-sol","source":"probe"},"effort":{"value":"high","source":"probe"},"role":null,"topic":null},"op":"note_add","patch":[{"op":"add","path":"/metadata/notes/1","value":{"created_at":"2026-09-26T15:49:25.706Z","author":"codex","text":"2026-09-26 verification: real Postgres + HTTP + PM workspace test failed before the patch because viewer GET installed pm-graph; after the patch it passes for viewer GET/HEAD, owner GET, denied viewer POST, and a missing CLI binary. A local activation-marker extension proves the extension inventory probe executes activate(), while graph GET/HEAD does not. pm test linked acceptance passed (1/1). npm run release:check passed, including npm and Bun packed acceptance. Coverage from coverage/lcov.info: 9,239/10,998 lines (84.01%), 1,344/1,670 branches (80.48%), 395/513 functions (77.00%); 100% target remains open under pm-web-ulgy/pm-web-9ulj. GET now always returns the certified built-in graph; edit-protected POST sync retains pm-graph provisioning."}},{"op":"replace","path":"/metadata/updated_at","value":"2026-09-26T15:49:25.707Z"}],"before_hash":"c5b72bba2bc82af901be78f30756d253e73cea0229ff78fe6a048231760c1a92","after_hash":"f8a1842103ba78970299932825a9501741b34a2b0dc5f24c36fb3f40206810ac","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"effort":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"version":{"status":"unavailable","reason":"harness_unavailable","resolver":"ai_agent_version","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"9472758fd2be26149545cff621efd3d485292dfa436ff12a38291747500f7ff6"}
