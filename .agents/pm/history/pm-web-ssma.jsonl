{"ts":"2026-07-12T14:20:29.351Z","author":"codex","op":"create","patch":[{"op":"replace","path":"/body","value":"GitHub issue: https://github.com/unbraind/pm-web/issues/33"},{"op":"add","path":"/metadata/id","value":"pm-web-ssma"},{"op":"add","path":"/metadata/title","value":"Make pm CLI execution non-blocking with bounded concurrency"},{"op":"add","path":"/metadata/description","value":"Replace synchronous child processes with awaitable execution so write bursts do not stall HTTP, SSE, or Postgres LISTEN callbacks."},{"op":"add","path":"/metadata/type","value":"Task"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":1},{"op":"add","path":"/metadata/tags","value":["concurrency","performance","pm-cli","realtime"]},{"op":"add","path":"/metadata/created_at","value":"2026-07-12T14:20:29.351Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-07-12T14:20:29.351Z"},{"op":"add","path":"/metadata/author","value":"codex"},{"op":"add","path":"/metadata/acceptance_criteria","value":"All pm command paths are asynchronous; commands serialize per workspace while independent workspaces run concurrently under a configurable global cap; timeouts and output limits terminate safely; event-loop responsiveness and concurrency behavior have automated tests; the hosted load test no longer shows multi-second foreign-event delivery stalls."},{"op":"add","path":"/metadata/parent","value":"pm-web-2rek"},{"op":"add","path":"/metadata/risk","value":"high"},{"op":"add","path":"/metadata/confidence","value":"high"},{"op":"add","path":"/metadata/expected_result","value":"pm-web remains responsive during pm CLI work and preserves safe workspace serialization."}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"28d3ef642e65bea2f160c2decd0189fe1bbcf2f9146b06d90b9b1089200ff22a","message":""}
