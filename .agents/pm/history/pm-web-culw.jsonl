{"hash_algorithm":"sha256","ts":"2026-10-05T04:42:47.146Z","author":"pi-glm","author_source":"asserted","agent_harness":"pi","agent_model":"glm-5.3:cloud","agent_model_source":"environment","agent_instance":"535465f5459a0ca510494480","agent_provenance":{"model":{"value":"glm-5.3:cloud","source":"environment"},"effort":null,"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-web-culw"},{"op":"add","path":"/metadata/title","value":"pm-web close-many previews and closes the whole project instead of only open items"},{"op":"add","path":"/metadata/description","value":"POST /api/projects/:projectId/pm/close-many lists its candidates with ['update-many', '--dry-run', '--status', 'open']. On update-many, --status SETS the status instead of filtering rows, and with no other update flags present the dry-run match set silently widened to every item in the project — closed items included, which then fail the individual close with a conflict and are reported as failed rows. The listing now uses --filter-status open, the flag the command actually defines for row selection."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":2},{"op":"add","path":"/metadata/tags","value":["bug","bulk-ops","http-semantics"]},{"op":"add","path":"/metadata/created_at","value":"2026-10-05T04:42:47.146Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-10-05T04:42:47.146Z"},{"op":"add","path":"/metadata/author","value":"pi-glm"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"e4d17514b1df28cc1962b25da3b9af34c6986c5f2ee741c35a99b702fd15a1d8","item_hash_version":3,"message":"","event_class":"substantive","record_hash_version":1,"record_hash":"49cb53d3addbaa3551d4b168f1eda49cf4aaf47ea82f8e0865158cb23b222888"}
