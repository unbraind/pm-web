{"hash_algorithm":"sha256","ts":"2026-10-05T04:42:42.911Z","author":"pi-glm","author_source":"asserted","agent_harness":"pi","agent_model":"glm-5.3:cloud","agent_model_source":"environment","agent_instance":"535465f5459a0ca510494480","agent_provenance":{"model":{"value":"glm-5.3:cloud","source":"environment"},"effort":null,"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-web-i1mr"},{"op":"add","path":"/metadata/title","value":"pm-web plan routes pass plan-level flags to step subcommands, so adding or editing a plan step never reaches the step"},{"op":"add","path":"/metadata/description","value":"POST /api/projects/:projectId/pm/plan/:planId/steps sends the step title as --title, but pm plan add-step requires --step-title (exit 2), so every add-step from the web UI fails with a usage error. PATCH /api/projects/:projectId/pm/plan/:planId/steps/:stepRef sends --title/--description, which pm plan update-step silently ignores, so the UI reports success while dropping the user's step edit. Both routes now send --step-title and --step-body."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":2},{"op":"add","path":"/metadata/tags","value":["bug","http-semantics","pm-plan"]},{"op":"add","path":"/metadata/created_at","value":"2026-10-05T04:42:42.911Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-10-05T04:42:42.911Z"},{"op":"add","path":"/metadata/author","value":"pi-glm"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"17a2e53a393f63790765747dbad651dabddb7ce7445adb9b7e752634124f5c63","item_hash_version":3,"message":"","event_class":"substantive","record_hash_version":1,"record_hash":"a2c2172cc09f20bef6735f5a902eff444c42e97a46ddbd1e99a4d45d21caf222"}
