{"ts":"2026-07-11T13:43:12.034Z","author":"codex","op":"update","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-07-11T13:43:12.034Z"},{"op":"add","path":"/metadata/resolution","value":"Public pm-web now supports reusable self-hosted OIDC using only generic OIDC_* configuration; full typecheck, tests, build, npm audit, and diff checks pass."},{"op":"add","path":"/metadata/expected_result","value":"Optional generic OIDC login is disabled by default, fails closed on partial production config, securely validates protocol state and identity, preserves password login, and adds no hosted values."},{"op":"add","path":"/metadata/actual_result","value":"Implemented openid-client discovery/JWKS Authorization Code + PKCE, signed state cookies, exact claim checks, transactional issuer-subject mapping, verified-email collision rules, OIDC-only provisioning, UI discovery, schema, docs, and 19 OIDC-focused checks within a 60-test passing suite."}],"before_hash":"833c0612be1271b45cc75f08e8ee61cd6faea5d168cb180943397537f47485fc","after_hash":"7a7de446cad3a86a03188076e2def28723b233dc38e7e22bfd82426968bce2bf","message":"Record completed OIDC verification"}
