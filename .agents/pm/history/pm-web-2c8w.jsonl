{"hash_algorithm":"sha256","ts":"2026-11-23T15:14:04.380Z","author":"codex-agent","author_source":"asserted","agent_harness":"pi","agent_model":"glm-5.3:cloud","agent_model_source":"environment","agent_instance":"a57641f91cb39b8fa204234a","agent_provenance":{"model":{"value":"glm-5.3:cloud","source":"environment"},"effort":null,"role":null,"topic":null},"op":"comment_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-11-23T15:14:04.380Z"},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-11-23T15:14:04.379Z","author":"codex-agent","text":"Reproduced in the package worktree with the pinned pm-github 2026.11.18 extension: the gated dry-run import exits 2 with github_import_owner_conflict for the importer-reserved issue-355 target id; the occupant item was created by hand with only a reference tag, so the plan treats issue 355 as new and refuses to create over the occupant. Importer-created provenance (the pm-github author or the dedicated importer marker) cannot be set through pm commands, so the supported repair is the link-only path the matcher documents: set the structured github identity fields plus the link-only marker on the occupant, which makes the importer match the item, link it to the issue, and preserve its curated content and status. The item itself is not moved or deleted; content, comments and append-only history are kept."}]}],"before_hash":"17c31c8c8c15a6197178e40b9b67182a7419f1757a4e2bbb7545cefb9ffbeef9","after_hash":"8bb36f5f51d8a91f681c8616d6b4ddee2bf2fa403d46a1456f25444cd98895b0","item_hash_version":3,"event_class":"substantive","record_hash_version":1,"record_hash":"e839ddcdda9d3345a573931994ba6823e8b27d655400d6e354b749cc480fa572"}
