{"hash_algorithm":"sha256","ts":"2026-11-23T15:13:54.245Z","author":"codex-agent","author_source":"asserted","agent_harness":"pi","agent_model":"glm-5.3:cloud","agent_model_source":"environment","agent_instance":"a57641f91cb39b8fa204234a","agent_provenance":{"model":{"value":"glm-5.3:cloud","source":"environment"},"effort":null,"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-web-2c8w"},{"op":"add","path":"/metadata/title","value":"Gated sync refuses the importer-reserved issue-355 item because the hand-made occupant lacks GitHub provenance"},{"op":"add","path":"/metadata/description","value":"The scheduled gated GitHub issue sync fails because the importer's deterministic target id for issue 355 is occupied by a hand-created tracker item that carries only a reference tag. The import refuses with github_import_owner_conflict: curated/unowned for content mirroring, importer creation provenance missing. The occupant item genuinely tracks issue 355, so the fix keeps its content in place and restores GitHub identity provenance as an explicit link-only mirror: set the structured github identity fields and the link-only marker so the importer matches the item, links it, and preserves local content instead of trying to create a duplicate at the reserved id."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":1},{"op":"add","path":"/metadata/tags","value":[]},{"op":"add","path":"/metadata/created_at","value":"2026-11-23T15:13:54.245Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-11-23T15:13:54.245Z"},{"op":"add","path":"/metadata/author","value":"codex-agent"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"de85e657e305d019cfec64fb7174dd249a2464e18791b1c778e34bd0dec2c214","item_hash_version":3,"message":"","event_class":"substantive