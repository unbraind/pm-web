    scope: project
    timeout_seconds: 60
  - command: npm run build
    scope: project
    timeout_seconds: 240
  - command: npm run typecheck
    scope: project
    timeout_seconds: 240
  - command: NPM_CONFIG_USERCONFIG=/dev/null npm audit --omit=dev
    scope: project
    timeout_seconds: 240
  - command: NPM_CONFIG_USERCONFIG=/dev/null npm pack --dry-run
    scope: project
    timeout_seconds: 300
  - command: npm test
    path: test/legal-pages.test.ts
    scope: project
    timeout_seconds: 240
  - command: npm test
    path: test/legal-routes.test.ts
    scope: project
    timeout_seconds: 240
docs[2]{path,scope,note}:
