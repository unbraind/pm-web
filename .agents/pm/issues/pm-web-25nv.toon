tests[2]:
  - command: "PM_PATH=/tmp/pmweb-25nv PM_GLOBAL_PATH=/tmp/pmweb-25nv-g node --test --test-name-pattern \"rotated X-Forwarded-For\" test/rate-limit.test.ts"
