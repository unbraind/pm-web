{
  "name": "@unbrained/pm-web",
  "version": "2026.8.31",
  "description": "Full web UI for pm-cli — browse, create, update, search and manage pm projects in the browser. Self-hosted via Docker or Node.js.",
  "type": "module",
  "files": [
    "dist/",
    "public/",
    "sql/",
    "manifest.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run build:server && npm run build:frontend",
    "build:server": "tsc",
    "start": "node dist/server.js",
    "typecheck": "npm run typecheck:server && npm run typecheck:frontend",
    "typecheck:server": "tsc --noEmit",
    "typecheck:frontend": "cd public && tsc --noEmit && tsc -p tsconfig.sw.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "build:frontend": "cd public && tsc && tsc -p tsconfig.sw.json && tsc -p tsconfig.scripts.json",
    "build:all": "npm run build",
    "check": "npm run typecheck",
    "docstring": "node scripts/docstring-gate.ts",
    "audit:prod": "node --input-type=module -e \"import { spawnSync } from 'node:child_process'; import { devNull } from 'node:os'; const env = { ...process.env, npm_config_userconfig: devNull, NPM_CONFIG_USERCONFIG: devNull }; for (const key of Object.keys(env)) if (key.toLowerCase() === 'npm_config_allow_scripts') delete env[key]; const win = process.platform === 'win32'; const r = spawnSync(win ? 'npm.cmd' : 'npm', ['audit', '--omit=dev', '--ignore-scripts'], { stdio: 'inherit', env, shell: win }); process.exit(r.status ?? 1);\"",
    "accept:packed": "node scripts/accept-packed.ts",
    "pack:dry-run": "npm pack --dry-run",
    "changelog": "pm-changelog --pm-root .agents/pm --pm-arg=--output-budget --pm-arg=unbounded --pm-arg=--output-limit --pm-arg=unbounded --mode prepend --output CHANGELOG.md --release-version-from-package --date-from-version --since-previous-tag --until-release-tag --item-url-base https://github.com/unbraind/pm-web/blob/main/.agents/pm --respect-item-release --pm-bin ./node_modules/.bin/pm",
    "changelog:full": "pm-changelog --pm-root .agents/pm --pm-arg=--output-budget --pm-arg=unbounded --pm-arg=--output-limit --pm-arg=unbounded --mode replace --output CHANGELOG.md --all-release-tags --release-version-from-package --date-from-version --item-url-base https://github.com/unbraind/pm-web/blob/main/.agents/pm --respect-item-release --pm-bin ./node_modules/.bin/pm",
    "changelog:check": "pm-changelog --pm-root .agents/pm --pm-arg=--output-budget --pm-arg=unbounded --pm-arg=--output-limit --pm-arg=unbounded --mode replace --output CHANGELOG.md --all-release-tags --release-version-from-package --date-from-version --item-url-base https://github.com/unbraind/pm-web/blob/main/.agents/pm --respect-item-release --pm-bin ./node_modules/.bin/pm --check",
    "release:notes": "pm-changelog --pm-root .agents/pm --pm-arg=--output-budget --pm-arg=unbounded --pm-arg=--output-limit --pm-arg=unbounded --stdout --since-previous-tag --until-release-tag --release-version-from-package --date-from-version --item-url-base https://github.com/unbraind/pm-web/blob/main/.agents/pm --respect-item-release --pm-bin ./node_modules/.bin/pm --github-step-summary",
    "release:check": "npm run check && npm run docstring && npm run coverage && npm run audit:prod && npm run pack:dry-run && npm run accept:packed && npm run changelog:check && npm run verify:release-changelog-date && npm run verify:release-publish-attestation",
    "prepack": "npm run build",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build && npm run build:test && node scripts/with-test-db.ts node --test test/*.test.ts",
    "prepublishOnly": "npm run release:check",
    "prepare": "node scripts/prepare-merge-driver.mjs",
    "merge:install": "pm merge install",
    "coverage": "npm run build && npm run build:test && node scripts/with-test-db.ts node scripts/coverage-gate.ts",
    "db:up": "node scripts/db-up.ts",
    "db:down": "node scripts/db-down.ts",
    "db:check": "node scripts/ensure-test-db.ts",
    "verify:release-changelog-date": "node scripts/verify-release-changelog-date.ts",
    "verify:release-publish-attestation": "node scripts/verify-release-publish-attestation.ts"
  },
  "dependencies": {
    "@unbrained/pm-cli": "2026.8.27",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "jsonwebtoken": "^9.0.2",
    "neo4j-driver": "^6.2.0",
    "openid-client": "^6.8.7",
    "pg": "^8.23.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^11.0.0",
    "pm-changelog": "2026.8.30",
    "pm-ops": "2026.8.17",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "yaml": "^2.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unbraind/pm-web.git"
  },
  "bugs": {
    "url": "https://github.com/unbraind/pm-web/issues"
  },
  "homepage": "https://github.com/unbraind/pm-web#readme",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=22.18.0"
  },
  "author": "@unbraind",
  "license": "MIT",
  "keywords": [
    "pm-cli",
    "pm-extension",
    "pm-package",
    "web"
  ],
  "pm": {
    "aliases": [
      "web"
    ],
    "extensions": [
      "."
    ],
    "catalog": {
      "display_name": "pm Web UI",
      "category": "app",
      "summary": "Full web UI for pm-cli — browse, create, update, search and manage pm projects in the browser. Self-hosted via Docker or Node.js.",
      "tags": [
        "web",
        "pwa",
        "collaboration",
        "github",
        "graph"
      ],
      "links": {
        "docs": "https://github.com/unbraind/pm-web#readme",
        "repository": "https://github.com/unbraind/pm-web",
        "report": "https://github.com/unbraind/pm-web/issues"
      }
    },
    "docs": [
      "README.md",
      "CHANGELOG.md"
    ],
    "examples": [
      "README.md"
    ]
  },
  "private": false,
  "coverageGate": {
    "sources": [
      "src"
    ],
    "tests": [
      "test/*.test.ts"
    ],
    "thresholds": {
      "lines": 66,
      "branches": 80,
      "functions": 60
    },
    "ignore": []
  }
}
